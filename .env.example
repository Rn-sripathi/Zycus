# Copy to .env and fill in. Never commit the real .env.

# Required: your OpenAI API key (server-side only, never exposed to the frontend).
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown).
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Confidence threshold: model self-reported confidence at or above this value is
# eligible for MEDIUM (auto-suggest); below it the finding is flagged for a human.
CONFIDENCE_THRESHOLD=0.8
