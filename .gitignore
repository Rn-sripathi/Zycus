# Secrets -- never commit
.env
.env.local
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
dist/
.vite/

# The built React bundle IS committed. FastAPI serves it, and committing it means
# a deploy needs only Python -- no Node in the build image, no npm step that can
# fail. Rebuild and commit it whenever the frontend changes:
#   cd frontend && npm run build

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
